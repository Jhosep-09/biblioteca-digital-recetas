<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F8">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D32F2F"
        android:elevation="6dp"
        android:title="Recetas"
        android:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- HEADER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recetas"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#B71C1C"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explora, aprende y cocina como un chef"
                android:textSize="15sp"
                android:textColor="#7A7A7A"
                android:gravity="left"
                android:layout_marginBottom="30dp" />

            <!-- CATEGORÍAS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CATEGORÍAS POPULARES"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#B71C1C"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="26dp">

                <!-- CARD BASE -->
                <!-- REEMPLAZA card_background por card_red_background -->
                <!-- ejemplo de card con estilo rojizo -->

                <!-- VEGETARIANA -->
                <LinearLayout
                    android:id="@+id/btnCategoryVegetariana"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="14dp"
                    android:background="@drawable/card_red_background"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥙"
                        android:textSize="34sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vegetariana"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#B71C1C" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(2)"
                        android:textSize="11sp"
                        android:textColor="#7A7A7A" />
                </LinearLayout>

                <!-- RÁPIDAS -->
                <LinearLayout
                    android:id="@+id/btnCategoryRapida"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="14dp"
                    android:background="@drawable/card_red_background"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍟"
                        android:textSize="34sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rápidas"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#B71C1C" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(4)"
                        android:textSize="11sp"
                        android:textColor="#7A7A7A" />
                </LinearLayout>

                <!-- POSTRES -->
                <LinearLayout
                    android:id="@+id/btnCategoryPostres"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="14dp"
                    android:background="@drawable/card_red_background"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧁"
                        android:textSize="34sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Postres"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#B71C1C" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(3)"
                        android:textSize="11sp"
                        android:textColor="#7A7A7A" />
                </LinearLayout>

                <!-- TODAS -->
                <LinearLayout
                    android:id="@+id/btnCategoryTodas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="14dp"
                    android:background="@drawable/card_red_background"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥘"
                        android:textSize="34sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Todas"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#B71C1C" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(10)"
                        android:textSize="11sp"
                        android:textColor="#7A7A7A" />
                </LinearLayout>
            </LinearLayout>

            <!-- RECETAS DESTACADAS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RECETAS DESTACADAS"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#B71C1C"
                android:layout_marginBottom="10dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recetasRecyclerView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
