<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Sección superior: Volver y Favorito -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Volver"
                android:layout_margin="12dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="#C62828"
                android:textColor="@android:color/white"
                android:elevation="4dp" />

            <ImageView
                android:id="@+id/btnFavorite"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_favorite_border"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_margin="12dp"
                android:padding="6dp" />
        </RelativeLayout>

        <!-- Imagen -->
        <ImageView
            android:id="@+id/recipeImageView"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:scaleType="centerCrop"
            android:background="#E0E0E0" />

        <!-- Información -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/recipeNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#B71C1C"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/recipeCategoryTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#8D6E63"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/recipeTimeTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#8D6E63"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/recipeDifficultyTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#8D6E63"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/recipeDescriptionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textColor="#4E342E"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <!-- Ingredientes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredientes:"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#B71C1C"
            android:padding="16dp"
            android:paddingBottom="8dp" />

        <ListView
            android:id="@+id/ingredientsListView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="#FFCDD2"
            android:dividerHeight="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp" />

        <!-- Pasos -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pasos de Preparación:"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#B71C1C"
            android:padding="16dp"
            android:paddingBottom="8dp"
            android:paddingTop="20dp" />

        <ListView
            android:id="@+id/stepsListView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="#FFCDD2"
            android:dividerHeight="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>
